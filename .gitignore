# Allowlist: ignore everything, then admit source files only. This keeps
# state files, exports and binaries out of a repository about money.
*

!/.gitignore
!*.go
!go.mod
!go.sum
!README.md
!LICENSE
!Makefile
!/scripts/
!/scripts/*.sh
!/scripts/generate-mascot.py
!/mascot.png
!/mascot-plaid.png
!/.claude-plugin/
!/.claude-plugin/*.json
!/skills/
!/skills/*/
!/skills/*/SKILL.md
!/.agents/
!/.agents/skills/
!/.agents/skills/*
!/docs/*.css
!/docs/
!/docs/*.svg
!/docs/index.html
!/docs/*/
!/docs/*/index.html
!/docs/*/*.png
!/docs/try/*/
!/docs/try/*/index.html

!*/
